 .screen { background: var(--glass-floating); -webkit-backdrop-filter: var(--glass-filter); backdrop-filter: var(--glass-filter); box-shadow: var(--glass-floating-shadow); }
 .footer .restart { background: var(--glass-control); border-color: var(--glass-edge); }
