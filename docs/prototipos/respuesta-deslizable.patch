+
+/* ── Deslizar en vez de pasar páginas (Sergio, 2026-10-02) ─────────────
+   El mismo marco; dentro, la respuesta se desliza. Abajo se funde con la
+   tarjeta y, si queda algo, lo dice una píldora del mismo cristal. */
+.deslizable { position: relative; min-height: 0; }
+.cuerpoDeslizable { height: 100%; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; display: flex; flex-direction: column; gap: 12px; padding-bottom: 8px; scrollbar-width: none; }
+.cuerpoDeslizable::-webkit-scrollbar { display: none; }
+.cuerpoDeslizable:focus { outline: none; }
+.bloqueDeslizable { flex: none; min-width: 0; overflow-wrap: anywhere; scroll-margin-top: 4px; }
+.tituloParte { display: flex; align-items: center; gap: 8px; margin: 10px 0 10px; font-size: 11px; font-weight: 700; letter-spacing: .6px; color: var(--ink-secondary); }
+.tituloParte svg { color: var(--purple-ink); }
+.masDebajo { position: absolute; left: 50%; bottom: 6px; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--glass-edge); background: var(--glass-control); box-shadow: var(--glass-control-shadow); -webkit-backdrop-filter: var(--glass-filter); backdrop-filter: var(--glass-filter); color: var(--purple-ink); font: inherit; font-size: 12px; font-weight: 600; cursor: pointer; white-space: nowrap; }
+.cuerpoDeslizable[data-debajo='true'] { -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 56px), transparent); mask-image: linear-gradient(to bottom, #000 calc(100% - 56px), transparent); }
+.cuerpoDeslizable[data-arriba='true'] { -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18px); mask-image: linear-gradient(to bottom, transparent, #000 18px); }
+.cuerpoDeslizable[data-arriba='true'][data-debajo='true'] { -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18px, #000 calc(100% - 56px), transparent); mask-image: linear-gradient(to bottom, transparent, #000 18px, #000 calc(100% - 56px), transparent); }
