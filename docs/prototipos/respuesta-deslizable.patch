+// ── DESLIZAR EN VEZ DE PASAR PÁGINAS (Sergio, 2026-10-02) ──────────────
+// Quien no veía «Siguiente» se perdía el resto: en el móvil se desliza con
+// el dedo. La respuesta se lee de arriba abajo dentro de la tarjeta; cada
+// parte («Otras opciones», «Ajustar esta búsqueda») lleva su título, y
+// mientras quede algo debajo, un aviso «Desliza para ver más».
+const DESLIZAR = true
+
 export default function ResponseScreen({ blocks, welcome, query }) {
+  if (DESLIZAR) return <RespuestaDeslizable blocks={blocks} welcome={welcome} query={query} />
+  return <RespuestaPaginada blocks={blocks} welcome={welcome} query={query} />
+}
+
+function RespuestaDeslizable({ blocks, welcome, query }) {
+  const areaRef = useRef(null)
+  const [quedaDebajo, setQuedaDebajo] = useState(false)
+  const [bajado, setBajado] = useState(false)
+  const signature = blocks.map(b => b.id).join('|')
+  useLayoutEffect(() => {
+    const area = areaRef.current
+    if (!area) return
+    const mirar = () => { setQuedaDebajo(area.scrollHeight - area.clientHeight - area.scrollTop > 24); setBajado(area.scrollTop > 4) }
+    mirar()
+    const observer = new ResizeObserver(mirar)
+    observer.observe(area)
+    ;[...area.children].forEach(el => observer.observe(el))
+    area.addEventListener('scroll', mirar, { passive: true })
+    return () => { observer.disconnect(); area.removeEventListener('scroll', mirar) }
+  }, [signature])
+  const ajustes = blocks.findIndex(block => block.section === 'Ajustar esta búsqueda')
+  const ir = id => areaRef.current?.querySelector(`[data-bloque="${CSS.escape(id)}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'start' })
+  const bajar = () => areaRef.current?.scrollBy({ top: areaRef.current.clientHeight * 0.75, behavior: 'smooth' })
+  return (
+    <section className={styles.screen} data-paged="false" data-deslizar="true" aria-label="Respuesta de Nüra">
+      <header className={styles.header}>
+        <img src="/logo-iso.png" alt="" width="32" height="32" />
+        <div className={styles.heading}>
+          <span className={styles.label}>{welcome ? 'Cerca de ti' : 'Tu búsqueda'}</span>
+          {query && <p className={styles.query} title={query}>{query}</p>}
+        </div>
+        {ajustes >= 0 && <button type="button" className={styles.adjust} onClick={() => ir(blocks[ajustes].id)} aria-label="Ir a ajustes de búsqueda" title="Ajustar búsqueda"><SlidersHorizontal size={18} aria-hidden="true" /></button>}
+      </header>
+      <div className={styles.deslizable}>
+        <div ref={areaRef} className={styles.cuerpoDeslizable} data-debajo={quedaDebajo} data-arriba={bajado} tabIndex={-1} aria-label="Contenido de la respuesta">
+          {blocks.map((block, index) => {
+            const titulo = block.section && block.section !== blocks[index - 1]?.section ? block.section : null
+            return <div key={block.id} data-bloque={block.id} className={styles.bloqueDeslizable} aria-hidden="false">
+              {titulo && <h2 className={styles.tituloParte}>{titulo === 'Otras opciones' ? <Users size={16} aria-hidden="true" /> : <SlidersHorizontal size={16} aria-hidden="true" />}{titulo}</h2>}
+              {block.content}
+            </div>
+          })}
+        </div>
+        {quedaDebajo && <button type="button" className={styles.masDebajo} onClick={bajar}>Desliza para ver más<ArrowDown size={15} aria-hidden="true" /></button>}
+      </div>
+    </section>
+  )
+}
