# Nüra 2 — variables de entorno
#
# VITE_DEMO
#   'true'  → plazos cortos y datos de demostración (por defecto en local)
#   'false' → plazos reales (3 días para la Confirmación Humana)
#   Si no se define, manda DEFAULT_DEMO en src/config.js
VITE_DEMO=true

# VITE_SUPABASE_ANON_KEY
#   Vive aquí para poder ROTARLA sin tocar código.
#   AVISO: esto NO la protege. Una anon key de Supabase está diseñada para
#   viajar al navegador, y Vite la incrusta en el paquete compilado igual.
#   Lo que protege de verdad es el RLS: el rol anónimo no debe tener
#   escritura sobre `helpers`.
VITE_SUPABASE_ANON_KEY=
